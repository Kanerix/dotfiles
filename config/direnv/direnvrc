# Symlinked to ~/.config/direnv/direnvrc by `just link`.

if [ -f "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]; then
    . "$HOME/.nix-profile/share/nix-direnv/direnvrc"
fi

use_devenv() {
    if ! command -v devenv >/dev/null 2>&1; then
        log_error "use devenv: devenv is not installed (nix profile upgrade cli-tools)"
        return 1
    fi
    eval "$(devenv direnvrc)"
    use_devenv "$@"
}
