# Symlinked to ~/.config/direnv/direnvrc by `just link`.

# nix-direnv replaces direnv's built-in use_flake with a caching version, and
# adds a gcroot so the dev shell survives garbage collection. Without it every
# cd into a flake project re-evaluates from scratch.
if [ -f "$HOME/.nix-profile/share/nix-direnv/direnvrc" ]; then
    . "$HOME/.nix-profile/share/nix-direnv/direnvrc"
fi

# devenv ships its own direnvrc, adapted from nix-direnv, which redefines three
# helpers nix-direnv also owns: _nix_direnv_preflight, _nix_export_or_unset and
# _nix_import_env. Sourcing it here would mean the last one loaded wins for all
# three, breaking `use flake` in every non-devenv project.
#
# So define only a stub. It loads the real implementation on first call, which
# happens inside a single .envrc evaluation, in its own bash process, where
# devenv's versions of those helpers are the correct ones. Projects using
# `use flake` never call this and keep nix-direnv's helpers intact.
#
# Generated by the binary rather than vendored, so it tracks the installed
# version.
use_devenv() {
    if ! command -v devenv >/dev/null 2>&1; then
        log_error "use devenv: devenv is not installed (nix profile upgrade cli-tools)"
        return 1
    fi
    eval "$(devenv direnvrc)"
    use_devenv "$@"
}
