{
    "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
    "root": false,
    "files": {
        "includes": ["**/*.json", "**/*.jsonc"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "linter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    },
    "json": {
        "parser": {
            "allowComments": true,
            "allowTrailingCommas": true
        },
        "formatter": {
            "enabled": true,
            "trailingCommas": "none"
        }
    }
}
