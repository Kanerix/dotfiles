[core]
    pager = delta

[url "git@github.com:"]
    insteadOf = https://github.com/

[user]
    email = kas@lerpz.com
    name = Kasper Jønsson
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFe0uvv1CMVATstZnqUhrlyMLXMppY0IZwyurnGnvEnR

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[color]
    ui = auto

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true

[merge]
    conflictstyle = zdiff3

[gpg]
    format = ssh

[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[commit]
    gpgsign = true
